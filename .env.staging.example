# Staging / VPS by IP — copy to `.env.staging` and fill secrets
DOMAIN=localhost
ENVIRONMENT=staging
FRONTEND_HOST=http://YOUR_SERVER_IP:8080
BACKEND_CORS_ORIGINS="http://YOUR_SERVER_IP:8080,http://YOUR_SERVER_IP:8081"
STACK_NAME=investment-staging

PROJECT_NAME="Investment Platform"
SECRET_KEY=changeme
FIRST_SUPERUSER=admin@example.com
FIRST_SUPERUSER_PASSWORD=changeme

SMTP_HOST=
SMTP_USER=
SMTP_PASSWORD=
EMAILS_FROM_EMAIL=info@example.com
EMAILS_FROM_NAME=Investment App
SMTP_TLS=True
SMTP_SSL=False
SMTP_PORT=465

POSTGRES_SERVER=db
POSTGRES_PORT=5432
POSTGRES_DB=investment-app
POSTGRES_USER=postgres
POSTGRES_PASSWORD=changeme

SENTRY_DSN=

DOCKER_IMAGE_BACKEND=backend
DOCKER_IMAGE_CLIENT=client-app
DOCKER_IMAGE_ADMIN=admin-app
